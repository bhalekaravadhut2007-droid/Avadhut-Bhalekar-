#include <stdio.h>
void rightAngleTriangle(int n) {
    printf("\nRight-Angle Triangle with Numbers:\n");
    int i,j;
    for ( i = 1; i <= n; i++) {
        for ( j = 1; j <= i; j++) {
            printf("%d ", j);
        }
        printf("\n");
    }
}
void diamondWithNumbers(int n) {
    printf("\nDiamond Shape with Numbers:\n");
    // Upper half
    int i,s,j;
    for ( i = 1; i <= n; i++) {
        for ( s = 1; s <= n - i; s++) {
            printf(" ");
        }
        for ( j = 1; j <= i; j++) {
            printf("%d ", j);
        }
        printf("\n");
    }
    
    for ( i = n - 1; i >= 1; i--) {
        for ( s = 1; s <= n - i; s++) {
            printf(" ");
        }
        for ( j = 1; j <= i; j++) {
            printf("%d ", j);
        }
        printf("\n");
    }
}
void pyramidWithStars(int n) {
    printf("\nPyramid with Asterisks:\n");
    int i,s,j;
    for ( i = 1; i <= n; i++) {
        for ( s = 1; s <= n - i; s++) {
            printf(" ");
        }
        for ( j = 1; j <= (2 * i - 1); j++) {
            printf("*");
        }
        printf("\n");
    }
}
int main() {
    int n;
    printf("Enter number of rows: ");
    scanf("%d", &n);
    rightAngleTriangle(n);
    diamondWithNumbers(n);
    pyramidWithStars(n);
    return 0;
}
